# Copia este archivo como .env.local para pruebas con "vercel dev".
# En produccion, estas variables se configuran en el panel de Vercel
# (Project Settings -> Environment Variables), NUNCA se suben al repositorio.

# Clave de la API de Claude (obligatoria). Se obtiene en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar (opcional). Por defecto: claude-sonnet-5
# Para maxima calidad (mas caro): claude-opus-5
# Analisis de costo por tarea en lab/decision_log.md (2026-07-25).
# CLAUDE_MODEL=claude-sonnet-5

# Correo de contacto para OpenAlex (opcional, pero recomendado por etiqueta de la API).
# OPENALEX_MAILTO=tu-correo@upr.edu

# ---- Contencion de costo (opcionales, ver web/lib/contencion.js) ----

# Origenes adicionales autorizados a llamar /api/*, separados por comas. El alias oficial
# del proyecto, las URLs que Vercel inyecta y localhost ya vienen incluidos por defecto,
# asi que normalmente NO hace falta poner esto. Sirve para habilitar un dominio propio.
# ORIGENES_PERMITIDOS=https://mi-dominio.edu,https://otro.example.com

# Limite de peticiones por prefijo de red (/24 en IPv4). Por defecto 60 por minuto y 600
# por hora, holgados a proposito: en un congreso decenas de personas comparten prefijo.
# Si alguien reporta un 429 usando la app con normalidad, sube LIMITE_POR_MINUTO.
# LIMITE_POR_MINUTO=60
# LIMITE_POR_HORA=600

# Diagnostico temporal. Con el valor 1, cada respuesta trae una cabecera
# x-diag-contencion con el prefijo detectado y el conteo en memoria. Sirve para averiguar
# por que el limite no dispara. Dejar SIN definir en produccion normal.
# DIAG_CONTENCION=1
